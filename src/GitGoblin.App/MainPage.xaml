<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:GitGoblin.Core;assembly=GitGoblin.Core"
             x:Class="GitGoblin.App.MainPage">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12"
          Padding="20">
        <Label Grid.Row="0"
               Text="GitGoblin"
               Style="{StaticResource Headline}"
               FontAttributes="Bold" />

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Entry Placeholder="Repository path"
                   Text="{Binding RepositoryPath}"
                   HorizontalOptions="Fill" />
            <Button Text="Load Status"
                    Clicked="OnLoadStatusClicked" />
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </HorizontalStackLayout>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="{Binding StatusSummary}" />
            <Label Grid.Column="1"
                   Text="{Binding BranchSummary}"
                   FontAttributes="Bold" />
        </Grid>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Changes}"
                        SelectionMode="None"
                        EmptyView="No working tree changes detected.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:GitFileChange">
                    <Grid Padding="8,6" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding Kind}" />
                        <Label Grid.Column="1" Text="{Binding Path}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="{Binding StatusCode}" HorizontalTextAlignment="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
