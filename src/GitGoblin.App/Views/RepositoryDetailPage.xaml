<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GitGoblin.App.Views.RepositoryDetailPage"
             Title="{Binding RepositoryName}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Tab Bar -->
        <Frame Grid.Row="0" Margin="15" Padding="5" CornerRadius="10" HasShadow="True">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Issues" 
                        Clicked="OnIssuesTapped"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Text="Commits" 
                        Clicked="OnCommitsTapped"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Text="Pull Requests" 
                        Clicked="OnPullRequestsTapped"
                        Style="{StaticResource TabButtonStyle}"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Content Area -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15" Padding="15">
                <!-- Repository Info Card -->
                <Frame CornerRadius="10" Padding="20" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding RepositoryName}" FontSize="24" FontAttributes="Bold"/>
                        <Label Text="{Binding Description}" TextColor="Gray"/>
                        
                        <BoxView HeightRequest="1" Color="LightGray" Margin="0,10"/>
                        
                        <Grid ColumnDefinitions="*,*,*" RowSpacing="10">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="⭐" FontSize="20" HorizontalOptions="Center"/>
                                <Label x:Name="StarsLabel" Text="0" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Stars" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="🔀" FontSize="20" HorizontalOptions="Center"/>
                                <Label x:Name="ForksLabel" Text="0" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Forks" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="❗" FontSize="20" HorizontalOptions="Center"/>
                                <Label x:Name="IssuesLabel" Text="0" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Issues" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Quick Actions -->
                <Label Text="Actions" FontSize="18" FontAttributes="Bold"/>
                
                <Frame CornerRadius="10" Padding="0" HasShadow="True">
                    <VerticalStackLayout>
                        <Frame Padding="15" BackgroundColor="Transparent" BorderColor="Transparent">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreatePRTapped"/>
                            </Frame.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="➕" FontSize="20"/>
                                <Label Text="Create Pull Request" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>
                        <BoxView HeightRequest="1" Color="LightGray"/>
                        <Frame Padding="15" BackgroundColor="Transparent" BorderColor="Transparent">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewBranchesTapped"/>
                            </Frame.GestureRecognizers>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="🌿" FontSize="20"/>
                                <Label Text="View Branches" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
