<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitGoblin.Core.ViewModels;assembly=GitGoblin.Core"
             x:Class="GitGoblin.App.Views.PullRequestDetailPage"
             x:DataType="vm:PullRequestDetailViewModel"
             Title="Pull Request"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">
            <!-- PR Header -->
            <Frame CornerRadius="10" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10">
                        <Frame Padding="8,4" 
                               CornerRadius="5" 
                               BackgroundColor="{Binding PullRequest.State, Converter={StaticResource StateToColorConverter}}">
                            <Label Text="{Binding PullRequest.State}" TextColor="White" FontSize="12"/>
                        </Frame>
                        <Label Text="{Binding PullRequest.Number, StringFormat='#{0}'}" 
                               FontSize="16" 
                               TextColor="Gray"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    
                    <Label Text="{Binding PullRequest.Title}" 
                           FontSize="22" 
                           FontAttributes="Bold"/>
                    
                    <Label Text="{Binding PullRequest.Body}" 
                           FontSize="14" 
                           TextColor="Gray"/>
                    
                    <!-- Branch Info -->
                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                        <Frame Padding="8,4" CornerRadius="5" BackgroundColor="{StaticResource Gray200}">
                            <Label Text="{Binding PullRequest.HeadRef}" FontSize="12"/>
                        </Frame>
                        <Label Text="→" VerticalOptions="Center" FontSize="16"/>
                        <Frame Padding="8,4" CornerRadius="5" BackgroundColor="{StaticResource Gray200}">
                            <Label Text="{Binding PullRequest.BaseRef}" FontSize="12"/>
                        </Frame>
                    </HorizontalStackLayout>
                    
                    <!-- Stats -->
                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,10,0,0">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding PullRequest.CommitsCount}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Commits" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="{Binding PullRequest.ChangedFilesCount}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Files" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="{Binding PullRequest.AdditionsCount}" FontSize="18" FontAttributes="Bold" TextColor="Green" HorizontalOptions="Center"/>
                            <Label Text="Additions" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                            <Label Text="{Binding PullRequest.DeletionsCount}" FontSize="18" FontAttributes="Bold" TextColor="Red" HorizontalOptions="Center"/>
                            <Label Text="Deletions" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Changed Files -->
            <Label Text="Changed Files" FontSize="18" FontAttributes="Bold"/>
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <CollectionView ItemsSource="{Binding Files}" HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="15,10" ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding FileName}" 
                                       FontSize="13" 
                                       LineBreakMode="MiddleTruncation"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding Additions, StringFormat='+{0}'}" 
                                       TextColor="Green" 
                                       FontSize="12"/>
                                <Label Grid.Column="2" 
                                       Text="{Binding Deletions, StringFormat='-{0}'}" 
                                       TextColor="Red" 
                                       FontSize="12"
                                       Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- Reviews Section -->
            <Label Text="Reviews" FontSize="18" FontAttributes="Bold"/>
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <CollectionView ItemsSource="{Binding Reviews}" HeightRequest="200">
                    <CollectionView.EmptyView>
                        <Label Text="No reviews yet" TextColor="Gray" Padding="15"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="10,5" Padding="15" CornerRadius="8">
                                <VerticalStackLayout Spacing="5">
                                    <HorizontalStackLayout Spacing="10">
                                        <Frame WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="0" IsClippedToBounds="True">
                                            <Image Source="{Binding AuthorAvatarUrl}" Aspect="AspectFill"/>
                                        </Frame>
                                        <Label Text="{Binding AuthorLogin}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Frame Padding="5,2" CornerRadius="5" BackgroundColor="{Binding State, Converter={StaticResource ReviewStateToColorConverter}}">
                                            <Label Text="{Binding State}" FontSize="10" TextColor="White"/>
                                        </Frame>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Body}" FontSize="13" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- Submit Review Section -->
            <Label Text="Submit Review" FontSize="18" FontAttributes="Bold"/>
            <Frame CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Editor Text="{Binding ReviewComment}" 
                            Placeholder="Write your review comment..."
                            HeightRequest="100"
                            AutoSize="TextChanges"/>
                    
                    <HorizontalStackLayout Spacing="10">
                        <RadioButton Content="Comment" IsChecked="True" GroupName="ReviewAction" 
                                    CheckedChanged="OnReviewActionChanged" Value="COMMENT"/>
                        <RadioButton Content="Approve" GroupName="ReviewAction"
                                    CheckedChanged="OnReviewActionChanged" Value="APPROVE"/>
                        <RadioButton Content="Request Changes" GroupName="ReviewAction"
                                    CheckedChanged="OnReviewActionChanged" Value="REQUEST_CHANGES"/>
                    </HorizontalStackLayout>
                    
                    <Button Text="Submit Review" 
                            Command="{Binding SubmitReviewCommand}"
                            BackgroundColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                              IsVisible="{Binding IsLoading}" 
                              Color="{StaticResource Primary}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
