<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitGoblin.Core.ViewModels;assembly=GitGoblin.Core"
             x:Class="GitGoblin.App.Views.IssuesPage"
             x:DataType="vm:IssuesViewModel"
             Title="Issues"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Filter Bar -->
        <Frame Grid.Row="0" Margin="15" Padding="10" CornerRadius="10" HasShadow="True">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="All" 
                        Command="{Binding}" 
                        CommandParameter="all"
                        Clicked="OnFilterChanged"
                        BackgroundColor="{Binding FilterState, Converter={StaticResource FilterToColorConverter}, ConverterParameter=all}"/>
                <Button Text="Open" 
                        Clicked="OnFilterChanged"
                        CommandParameter="open"/>
                <Button Text="Closed" 
                        Clicked="OnFilterChanged"
                        CommandParameter="closed"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Issues List -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsLoading}" 
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Issues}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="✅" FontSize="48"/>
                        <Label Text="No issues found" FontSize="18" TextColor="Gray"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="15,5" Padding="15" CornerRadius="10" HasShadow="True">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="15" RowSpacing="5">
                                <!-- State Icon -->
                                <Frame Grid.RowSpan="3" 
                                       WidthRequest="40" HeightRequest="40" 
                                       CornerRadius="20" 
                                       BackgroundColor="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                       Padding="0"
                                       VerticalOptions="Start">
                                    <Label Text="{Binding State, Converter={StaticResource StateToIconConverter}}" 
                                           FontSize="20" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"
                                           TextColor="White"/>
                                </Frame>
                                
                                <!-- Title -->
                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                    <Label Text="{Binding Title}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Number, StringFormat='#{0}'}" 
                                           FontSize="14" 
                                           TextColor="Gray"/>
                                </HorizontalStackLayout>
                                
                                <!-- Labels -->
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                    <CollectionView ItemsSource="{Binding Labels}" 
                                                    ItemsLayout="HorizontalList"
                                                    HeightRequest="25">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Frame Padding="5,2" 
                                                       CornerRadius="5" 
                                                       BackgroundColor="{StaticResource Primary}"
                                                       Margin="0,0,5,0">
                                                    <Label Text="{Binding}" FontSize="10" TextColor="White"/>
                                                </Frame>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </HorizontalStackLayout>
                                
                                <!-- Meta Info -->
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="10">
                                    <Label Text="{Binding AuthorLogin}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" FontSize="12" TextColor="Gray"/>
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="💬" FontSize="10"/>
                                        <Label Text="{Binding CommentsCount}" FontSize="12" TextColor="Gray"/>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
